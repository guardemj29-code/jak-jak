<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>KindLink — Get help. Give help.</title>
<meta name="description" content="Find real help near you: food, housing, mental health, jobs. Or offer help to neighbors.">
<style>
  :root{
    --bg:#faf9f6; --card:#ffffff; --ink:#1d2533; --muted:#5b6472;
    --brand:#0e7c66; --brand-dark:#0a5c4c; --accent:#f4b942;
    --danger:#b3261e; --line:#e5e2da; --radius:14px;
  }
  *{box-sizing:border-box;margin:0;padding:0}
  html{scroll-behavior:smooth}
  body{font-family:system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;background:var(--bg);color:var(--ink);line-height:1.55}
  a{color:var(--brand-dark)}
  .wrap{max-width:1050px;margin:0 auto;padding:0 1.25rem}
  .skip{position:absolute;left:-999px;top:0;background:var(--brand);color:#fff;padding:.6rem 1rem;border-radius:0 0 8px 0;z-index:99}
  .skip:focus{left:0}

  /* Header */
  header{background:var(--card);border-bottom:1px solid var(--line);position:sticky;top:0;z-index:10}
  .nav{display:flex;align-items:center;gap:1rem;padding:.8rem 0;flex-wrap:wrap}
  .logo{font-weight:800;font-size:1.25rem;color:var(--brand-dark);text-decoration:none}
  .logo span{color:var(--accent)}
  nav{margin-left:auto;display:flex;gap:1rem;flex-wrap:wrap}
  nav a{text-decoration:none;color:var(--muted);font-weight:600;font-size:.95rem;padding:.3rem .5rem;border-radius:8px}
  nav a:hover,nav a:focus{background:#eef4f2;color:var(--brand-dark)}

  /* Hero */
  .hero{padding:3.5rem 0 2.5rem;text-align:center}
  .hero h1{font-size:clamp(1.9rem,5vw,3rem);line-height:1.15;letter-spacing:-.02em}
  .hero p{color:var(--muted);max-width:560px;margin:.8rem auto 1.5rem;font-size:1.1rem}
  .searchbar{display:flex;gap:.5rem;max-width:560px;margin:0 auto}
  .searchbar input{flex:1;padding:.85rem 1rem;border:1px solid var(--line);border-radius:10px;font-size:1rem}
  .searchbar input:focus{outline:2px solid var(--brand);outline-offset:1px}
  .btn{display:inline-block;padding:.85rem 1.4rem;border-radius:10px;border:0;font-weight:700;font-size:1rem;cursor:pointer;text-decoration:none;text-align:center}
  .btn-primary{background:var(--brand);color:#fff}
  .btn-primary:hover{background:var(--brand-dark)}
  .btn-ghost{background:#fff;color:var(--brand-dark);border:1px solid var(--line)}
  .btn-danger{background:var(--danger);color:#fff}
  .btn-sm{padding:.4rem .8rem;font-size:.85rem}

  /* Emergency strip */
  .alert{background:#fdeceb;border:1px solid #f5c6c2;border-radius:var(--radius);padding:1rem 1.25rem;margin:1.5rem 0;font-size:.95rem}
  .alert strong{color:var(--danger)}

  /* Sections */
  section{padding:2.5rem 0}
  h2{font-size:1.6rem;letter-spacing:-.01em;margin-bottom:.3rem}
  .sub{color:var(--muted);margin-bottom:1.4rem}
  .chips{display:flex;gap:.5rem;flex-wrap:wrap;margin-bottom:1.4rem}
  .chip{padding:.45rem .95rem;border-radius:999px;border:1px solid var(--line);background:#fff;cursor:pointer;font-weight:600;font-size:.9rem;color:var(--muted)}
  .chip[aria-pressed="true"]{background:var(--brand);border-color:var(--brand);color:#fff}

  /* Cards */
  .grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:1rem}
  .card{background:var(--card);border:1px solid var(--line);border-radius:var(--radius);padding:1.2rem;display:flex;flex-direction:column;gap:.5rem}
  .card h3{font-size:1.05rem}
  .tag{display:inline-block;font-size:.75rem;font-weight:700;letter-spacing:.04em;text-transform:uppercase;color:var(--brand-dark);background:#e7f3ef;border-radius:6px;padding:.15rem .5rem;align-self:flex-start}
  .card p{color:var(--muted);font-size:.93rem}
  .card .meta{font-size:.85rem;color:var(--ink)}
  .card .actions{margin-top:auto;display:flex;gap:.5rem;align-items:center;justify-content:space-between;padding-top:.5rem}
  .star{background:none;border:0;font-size:1.2rem;cursor:pointer;color:#b9b2a4}
  .star[aria-pressed="true"]{color:var(--accent)}
  .empty{color:var(--muted);padding:2rem;text-align:center;border:1px dashed var(--line);border-radius:var(--radius);grid-column:1/-1}

  /* Board form */
  form{display:grid;gap:.8rem;background:var(--card);border:1px solid var(--line);border-radius:var(--radius);padding:1.4rem}
  label{font-weight:600;font-size:.92rem}
  input,select,textarea{padding:.7rem .9rem;border:1px solid var(--line);border-radius:9px;font:inherit;background:#fff;color:var(--ink);width:100%}
  textarea{min-height:90px;resize:vertical}
  :is(input,select,textarea):focus{outline:2px solid var(--brand);outline-offset:1px}
  .row{display:grid;gap:.8rem;grid-template-columns:1fr 1fr}
  .notice{font-size:.85rem;color:var(--muted);background:#f6f2e7;border:1px solid #ead9ae;border-radius:9px;padding:.6rem .8rem}
  .post{border-left:4px solid var(--brand)}
  .post.need{border-left-color:var(--danger)}
  .post .who{font-weight:700}
  .post time{color:var(--muted);font-size:.82rem}

  footer{border-top:1px solid var(--line);padding:2rem 0 3rem;color:var(--muted);font-size:.88rem;margin-top:2rem}
  footer a{color:var(--muted)}
  @media(max-width:640px){.row{grid-template-columns:1fr}.searchbar{flex-direction:column}}
</style>
</head>
<body>
<a class="skip" href="#resources">Skip to resources</a>

<header>
  <div class="wrap nav">
    <a class="logo" href="#top">Kind<span>Link</span></a>
    <nav aria-label="Main">
      <a href="#resources">Find help</a>
      <a href="#board">Help board</a>
      <a href="#give">Give help</a>
      <a href="#about">About</a>
    </nav>
  </div>
</header>

<main id="top">
  <!-- HERO -->
  <div class="wrap hero">
    <h1>Get help. Give help.<br>Right where you live.</h1>
    <p>Real, free resources for food, housing, health, work, and crisis support — plus a board to ask or offer a hand in your community.</p>
    <div class="searchbar">
      <label class="skip" for="q">Search resources</label>
      <input id="q" type="search" placeholder="Try: food, rent, crisis, job…">
      <button class="btn btn-primary" id="searchBtn">Search</button>
    </div>
  </div>

  <!-- EMERGENCY -->
  <div class="wrap">
    <div class="alert" role="note">
      <strong>In immediate danger?</strong> Call your local emergency number (911 in the US).
      In crisis? Call or text <strong>988</strong> (US Suicide &amp; Crisis Lifeline) or find a line in your country at
      <a href="https://findahelpline.com" target="_blank" rel="noopener">findahelpline.com</a>.
    </div>
  </div>

  <!-- RESOURCES -->
  <section id="resources">
    <div class="wrap">
      <h2>Find help</h2>
      <p class="sub">Free, reputable services. Always confirm hours and eligibility on their site before you go.</p>
      <div class="chips" id="chips" role="group" aria-label="Filter by category"></div>
      <div class="grid" id="resourceGrid" aria-live="polite"></div>
    </div>
  </section>

  <!-- BOARD -->
  <section id="board">
    <div class="wrap">
      <h2>Community help board</h2>
      <p class="sub">Post a request or an offer. Posts are saved in <em>your browser only</em> for now — nothing is published online (see About).</p>
      <form id="postForm" novalidate>
        <div class="row">
          <div>
            <label for="pType">I'm posting a…</label>
            <select id="pType" required>
              <option value="need">Request for help</option>
              <option value="offer">Offer of help</option>
            </select>
          </div>
          <div>
            <label for="pCat">Category</label>
            <select id="pCat" required>
              <option value="">Choose…</option>
              <option>Food</option><option>Housing</option><option>Health</option>
              <option>Jobs</option><option>Transport</option><option>Family</option>
              <option>Learning</option><option>Other</option>
            </select>
          </div>
        </div>
        <div class="row">
          <div>
            <label for="pName">Name or nickname (optional)</label>
            <input id="pName" maxlength="40" placeholder="e.g. Sam in Riverside">
          </div>
          <div>
            <label for="pCity">City or neighborhood</label>
            <input id="pCity" maxlength="60" placeholder="e.g. Springfield" required>
          </div>
        </div>
        <div>
          <label for="pDesc">What do you need / can you offer?</label>
          <textarea id="pDesc" maxlength="500" placeholder="Be specific, but don't share sensitive personal info." required></textarea>
        </div>
        <div>
          <label for="pContact">How can people reach you? (optional)</label>
          <input id="pContact" maxlength="80" placeholder="email, phone, or 'reply on the board'">
        </div>
        <p class="notice">🔒 Stored locally on this device. Don't post addresses, medical details, or anything you wouldn't put on a public wall.</p>
        <button class="btn btn-primary" type="submit">Post to board</button>
      </form>
      <div class="chips" id="boardChips" style="margin-top:1.5rem" role="group" aria-label="Filter board"></div>
      <div class="grid" id="postGrid" aria-live="polite"></div>
    </div>
  </section>

  <!-- GIVE -->
  <section id="give">
    <div class="wrap">
      <h2>Give help</h2>
      <p class="sub">Five ways to make a real difference this week:</p>
      <div class="grid">
        <div class="card"><span class="tag">Volunteer</span><h3>Give your time</h3><p>Search opportunities at <a href="https://www.volunteermatch.org" target="_blank" rel="noopener">VolunteerMatch</a> or your local food bank, library, or shelter.</p></div>
        <div class="card"><span class="tag">Donate</span><h3>Give goods, not junk</h3><p>Food banks most need shelf-stable proteins, grains, and hygiene items. Call first — wishlists vary.</p></div>
        <div class="card"><span class="tag">Skills</span><h3>Teach what you know</h3><p>Tutoring, résumé help, translation, rides to appointments — offer it on the board above.</p></div>
        <div class="card"><span class="tag">Money</span><h3>Give efficiently</h3><p>Check charities before giving at <a href="https://www.charitynavigator.org" target="_blank" rel="noopener">CharityNavigator</a>. Recurring small gifts help more than one-off big ones.</p></div>
        <div class="card"><span class="tag">Everyday</span><h3>Notice your neighbors</h3><p>Check on elderly neighbors in heat waves and cold snaps. Small acts count.</p></div>
      </div>
    </div>
  </section>

  <!-- ABOUT -->
  <section id="about">
    <div class="wrap">
      <h2>About &amp; honesty box</h2>
      <ul class="sub" style="padding-left:1.2rem">
        <li>Resources listed are real, established organizations. Details change — <strong>verify before relying on them</strong>.</li>
        <li>This site is not a crisis service. Emergencies go to 911 (US) or your local emergency number.</li>
        <li>Board posts never leave your device (localStorage). To run a real public board, add a backend + moderation before sharing widely.</li>
        <li>No accounts, no tracking, no cookies. Everything stays with you.</li>
      </ul>
    </div>
  </section>
</main>

<footer>
  <div class="wrap">
    KindLink — a community starter template. Replace this footer with your organization's name and contact info.
  </div>
</footer>

<script>
/* ---------------- Data: real, stable resources (US-heavy, international noted) ---------------- */
const RESOURCES = [
  {cat:"Crisis", name:"988 Suicide & Crisis Lifeline", desc:"Free, confidential 24/7 support for anyone in emotional distress or suicidal crisis. Call or text.", meta:"US · Call/text 988 · 988lifeline.org", url:"https://988lifeline.org"},
  {cat:"Crisis", name:"Crisis Text Line", desc:"Text with a trained crisis counselor, any time, for free.", meta:"US/CA/UK · Text HOME to 741741", url:"https://www.crisistextline.org"},
  {cat:"Crisis", name:"Find a Helpline", desc:"Verified crisis helplines in 130+ countries — pick your country and need.", meta:"International", url:"https://findahelpline.com"},
  {cat:"Crisis", name:"National Domestic Violence Hotline", desc:"24/7 support, safety planning, and local shelter referrals.", meta:"US · 1-800-799-7233 · thehotline.org", url:"https://www.thehotline.org"},
  {cat:"Food", name:"Feeding America Food Bank Finder", desc:"Enter your ZIP code to find your local food bank and free meal programs.", meta:"US · Free", url:"https://www.feedingamerica.org/find-your-local-foodbank"},
  {cat:"Food", name:"WhyHunger Hotline", desc:"Help finding food pantries, meals, and nutrition programs near you.", meta:"US · 1-800-5-HUNGRY", url:"https://whyhunger.org"},
  {cat:"Housing", name:"HUD Housing Counseling", desc:"Free or low-cost advice on renting, avoiding foreclosure, and finding shelters.", meta:"US · 1-800-569-4287", url:"https://www.hud.gov"},
  {cat:"Housing", name:"211 Essential Services", desc:"Dial 211 or search online — rent help, shelters, utilities, childcare, and more, by location.", meta:"US · Free · 24/7", url:"https://www.211.org"},
  {cat:"Health", name:"SAMHSA Helpline", desc:"Free, confidential 24/7 treatment referral for mental health and substance use.", meta:"US · 1-800-662-4357", url:"https://www.samhsa.gov/find-help/national-helpline"},
  {cat:"Health", name:"NAMI HelpLine", desc:"Information, resource referrals, and emotional support for mental health conditions.", meta:"US · nami.org/help", url:"https://www.nami.org/help"},
  {cat:"Jobs", name:"CareerOneStop", desc:"US Dept. of Labor: job search, training programs, résumé help, unemployment info.", meta:"US · Free", url:"https://www.careeronestop.org"},
  {cat:"Jobs", name:"Goodwill Career Centers", desc:"Free job training, placement, and financial coaching in most US communities.", meta:"US · Free", url:"https://www.goodwill.org"},
  {cat:"Money", name:"LIHEAP Energy Assistance", desc:"Federal help paying heating and cooling bills; apply through your state.", meta:"US · Income-eligible", url:"https://www.acf.gov/liheap"},
  {cat:"Family", name:"Child Care Assistance (CCDF)", desc:"Subsidized childcare for qualifying working families, run by each US state.", meta:"US · Income-eligible", url:"https://www.acf.hhs.gov/occ"},
  {cat:"Transport", name:"United Way Community Programs", desc:"Local rides, transit vouchers, and other practical assistance via your local United Way.", meta:"US + worldwide", url:"https://www.unitedway.org"},
];

const CATS = ["All","Food","Housing","Health","Jobs","Money","Family","Transport","Crisis"];
const POST_CATS = ["All","Food","Housing","Health","Jobs","Transport","Family","Learning","Other"];
const LS_POSTS = "kindlink_posts";
const LS_SAVED = "kindlink_saved";

const $ = s => document.querySelector(s);
const esc = t => t.replace(/[&<>"']/g, c => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));

/* ---------------- Resource directory ---------------- */
let activeCat = "All", query = "";

function renderChips(container, cats, current, onPick){
  container.innerHTML = "";
  cats.forEach(c => {
    const b = document.createElement("button");
    b.className = "chip"; b.type = "button"; b.textContent = c;
    b.setAttribute("aria-pressed", String(c === current));
    b.onclick = () => { onPick(c); };
    container.appendChild(b);
  });
}

function renderResources(){
  const grid = $("#resourceGrid");
  const saved = JSON.parse(localStorage.getItem(LS_SAVED) || "[]");
  const items = RESOURCES.filter(r =>
    (activeCat === "All" || r.cat === activeCat) &&
    (!query || (r.name + " " + r.desc + " " + r.cat).toLowerCase().includes(query))
  );
  grid.innerHTML = items.length ? "" :
    '<div class="empty">No matches. Try a broader term like "food" or "help".</div>';
  items.forEach(r => {
    const el = document.createElement("article");
    el.className = "card";
    const isSaved = saved.includes(r.name);
    el.innerHTML = `
      <span class="tag">${esc(r.cat)}</span>
      <h3><a href="${r.url}" target="_blank" rel="noopener">${esc(r.name)}</a></h3>
      <p>${esc(r.desc)}</p>
      <div class="meta">${esc(r.meta)}</div>
      <div class="actions">
        <a class="btn btn-ghost btn-sm" href="${r.url}" target="_blank" rel="noopener">Visit site ↗</a>
        <button class="star" aria-pressed="${isSaved}" aria-label="Save ${esc(r.name)}" title="Save for later">${isSaved ? "★" : "☆"}</button>
      </div>`;
    el.querySelector(".star").onclick = e => {
      const cur = JSON.parse(localStorage.getItem(LS_SAVED) || "[]");
      const i = cur.indexOf(r.name);
      i >= 0 ? cur.splice(i, 1) : cur.push(r.name);
      localStorage.setItem(LS_SAVED, JSON.stringify(cur));
      renderResources();
    };
    grid.appendChild(el);
  });
}

/* ---------------- Community board (localStorage demo) ---------------- */
let boardCat = "All";

function getPosts(){ return JSON.parse(localStorage.getItem(LS_POSTS) || "[]"); }
function setPosts(p){ localStorage.setItem(LS_POSTS, JSON.stringify(p)); }

function renderBoard(){
  const grid = $("#postGrid");
  const posts = getPosts().filter(p => boardCat === "All" || p.cat === boardCat).sort((a,b) => b.ts - a.ts);
  grid.innerHTML = posts.length ? "" :
    '<div class="empty">No posts yet in this category. Be the first — the form above is right there.</div>';
  posts.forEach(p => {
    const el = document.createElement("article");
    el.className = "card post" + (p.type === "need" ? " need" : "");
    const when = new Date(p.ts).toLocaleDateString(undefined,{month:"short",day:"numeric"});
    el.innerHTML = `
      <span class="tag">${p.type === "need" ? "Needs help" : "Offering help"} · ${esc(p.cat)}</span>
      <div class="who">${esc(p.name || "Anonymous")} · <span>${esc(p.city)}</span></div>
      <p>${esc(p.desc)}</p>
      ${p.contact ? `<div class="meta">Contact: ${esc(p.contact)}</div>` : ""}
      <div class="actions"><time>${when}</time>
      <button class="btn btn-ghost btn-sm" aria-label="Delete post">Delete</button></div>`;
    el.querySelector("button").onclick = () => {
      setPosts(getPosts().filter(x => x.id !== p.id));
      renderBoard();
    };
    grid.appendChild(el);
  });
}

$("#postForm").addEventListener("submit", e => {
  e.preventDefault();
  const desc = $("#pDesc").value.trim(), cat = $("#pCat").value, city = $("#pCity").value.trim();
  if (!desc || !cat || !city){
    alert("Please fill in category, city, and description.");
    return;
  }
  const post = {
    id: Date.now() + "" + Math.random().toString(36).slice(2,6),
    type: $("#pType").value, cat, city,
    name: $("#pName").value.trim(), desc, contact: $("#pContact").value.trim(), ts: Date.now()
  };
  setPosts([post, ...getPosts()]);
  e.target.reset();
  renderBoard();
});

/* ---------------- Wiring ---------------- */
function pickResourceCat(c){ activeCat = c; renderChips($("#chips"), CATS, c, pickResourceCat); renderResources(); }
function pickBoardCat(c){ boardCat = c; renderChips($("#boardChips"), POST_CATS, c, pickBoardCat); renderBoard(); }
function doSearch(){
  query = $("#q").value.trim().toLowerCase();
  if (query){ document.getElementById("resources").scrollIntoView({behavior:"smooth"}); }
  renderResources();
}
$("#searchBtn").onclick = doSearch;
$("#q").addEventListener("keydown", e => { if (e.key === "Enter") doSearch(); });

pickResourceCat("All");
pickBoardCat("All");
renderBoard();
</script>
</body>
</html>
